    stopFollowing()
    for _, conn in ipairs(inputConnections) do pcall(function() conn:Disconnect() end) end
    inputConnections = {}
    if wConn then pcall(function() wConn:Disconnect() end); wConn = nil end
    UIS.ModalEnabled = false
