-- ===================== TOGGLE HELPER =====================
local function makeToggle(label, hotkey, yPos)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, -16, 0, 52)
    bg.Position = UDim2.new(0, 8, 0, yPos)
    bg.BackgroundColor3 = CARD
    bg.BorderSizePixel = 0
    bg.Parent = frame
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", bg)
    s.Color = ACCENT2
    s.Thickness = 1

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -60, 0, 22)
    lbl.Position = UDim2.new(0, 10, 0, 6)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = TEXTW
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = bg

    local hot = Instance.new("TextLabel")
    hot.Size = UDim2.new(1, -10, 0, 18)
    hot.Position = UDim2.new(0, 10, 0, 30)
    hot.BackgroundTransparency = 1
    hot.Text = hotkey
    hot.TextColor3 = TEXTDIM
    hot.Font = Enum.Font.Gotham
    hot.TextSize = 10
    hot.TextXAlignment = Enum.TextXAlignment.Left
    hot.Parent = bg

    local pill = Instance.new("Frame")
    pill.Size = UDim2.new(0, 40, 0, 22)
    pill.Position = UDim2.new(1, -50, 0.5, -11)
    pill.BackgroundColor3 = RED
    pill.BorderSizePixel = 0
    pill.Parent = bg
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 16, 0, 16)
    dot.Position = UDim2.new(0, 3, 0.5, -8)
    dot.BackgroundColor3 = Color3.new(1,1,1)
    dot.BorderSizePixel = 0
    dot.Parent = pill
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local state = false
    local function setVis(on)
        TS:Create(pill, TweenInfo.new(0.15), {BackgroundColor3 = on and GREEN or RED}):Play()
        TS:Create(dot,  TweenInfo.new(0.15), {Position = on and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)}):Play()
        TS:Create(bg,   TweenInfo.new(0.15), {BackgroundColor3 = on and Color3.fromRGB(20,10,40) or CARD}):Play()
        s.Color = on and ACCENT or ACCENT2
    end

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,1,0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = 3
    btn.Parent = bg

    local function toggle() state = not state; setVis(state); return state end
    return btn, toggle
end

