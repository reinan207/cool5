-- ===================== SEGUIR JOGADOR =====================
local function stopFollowing()
    if followConnection then followConnection:Disconnect(); followConnection=nil end
    followingTarget = nil
    local char = lp.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed=16; hum.JumpPower=50 end
    end
    StopBar.Visible = false
end

local function startFollowing(target)
    stopFollowing()
    local myChar=lp.Character; local targetChar=target.Character
    if not myChar or not targetChar then return end
    local myRoot=myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot=targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end
    local hum=myChar:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed=0; hum.JumpPower=0 end
    followingTarget=target
    StopLabel.Text="🔒 Seguindo: "..target.DisplayName
    StopBar.Visible=true

    -- Calcula offset só no plano horizontal (ignora Y do alvo)
    local myPos = myRoot.Position
    local tPos  = targetRoot.Position
    local offsetX = myPos.X - tPos.X
    local offsetZ = myPos.Z - tPos.Z
    -- Trava a altura do meu boneco no chão onde ele está agora
    local lockedY = myPos.Y

    followConnection=RunService.Heartbeat:Connect(function()
        local tChar=target.Character
        if not tChar then stopFollowing(); return end
        local tRoot=tChar:FindFirstChild("HumanoidRootPart")
        local mChar=lp.Character
        local mRoot=mChar and mChar:FindFirstChild("HumanoidRootPart")
        if tRoot and mRoot then
            local tPos2 = tRoot.Position
            local newPos = Vector3.new(tPos2.X + offsetX, lockedY, tPos2.Z + offsetZ)
            mRoot.CFrame = CFrame.new(newPos) * (mRoot.CFrame - mRoot.CFrame.Position)
        end
    end)
end

