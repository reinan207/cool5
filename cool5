-- Estado da última resposta: nil = ignorou, true = SIM, false = NÃO
local lastReminderAnswer = nil

local function updatePopupBorder()
    local color
    if lastReminderAnswer == true then
        color = GREEN
    elseif lastReminderAnswer == false then
        color = RED
    else
        color = CYAN
    end
    rpStr.Color = color
    rpIndStroke.Color = color
    TS:Create(rpIndDot, TweenInfo.new(0.2), {BackgroundColor3 = color}):Play()
    TS:Create(rpIndicator, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(20, 20, 35)}):Play()
end

local function showReminderPopup()
    if not gui or not gui.Parent then return end
    if reminderPopup.Visible then return end
    updatePopupBorder()
    reminderPopup.Position = UDim2.new(1, -276, 0, -130)
    reminderPopup.Visible = true
    TS:Create(reminderPopup, TweenInfo.new(0.3, Enum.EasingStyle.Back), {Position = UDim2.new(1,-276,0,16)}):Play()
    -- Auto-fecha sem resposta (não altera lastReminderAnswer)
    autoDismissThread = task.delay(25, function()
        autoDismissThread = nil
        hideReminderPopup()
    end)
end

