local function clearESP(p)
    if espHL[p] then for _,h in ipairs(espHL[p]) do pcall(function() h:Destroy() end) end; espHL[p]=nil end
end
local function applyESP(p)
    if p==lp then return end
    local char=p.Character; if not char then return end
    clearESP(p)
    local hl=Instance.new("Highlight")
    hl.FillColor=ACCENT; hl.OutlineColor=CYAN
    hl.FillTransparency=0.6; hl.OutlineTransparency=0
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.Adornee=char; hl.Parent=char

    -- Nome acima do personagem
    local head = char:FindFirstChild("Head")
    if head then
        local bb = Instance.new("BillboardGui")
        bb.Size = UDim2.new(0, 120, 0, 30)
        bb.StudsOffset = Vector3.new(0, 2.5, 0)
        bb.AlwaysOnTop = true
        bb.Adornee = head
        bb.Parent = head

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Size = UDim2.new(1, 0, 1, 0)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = p.DisplayName
        nameLbl.TextColor3 = Color3.new(1, 1, 1)
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 14
        nameLbl.TextStrokeTransparency = 0.4
        nameLbl.TextStrokeColor3 = Color3.new(0, 0, 0)
        nameLbl.Parent = bb

        espHL[p] = {hl, bb}
    else
        espHL[p] = {hl}
    end
end
local function enableESP() for _,p in ipairs(Players:GetPlayers()) do applyESP(p) end end
local function disableESP() for p in pairs(espHL) do clearESP(p) end end
local function connectESP(p)
    if p==lp then return end
    p.CharacterAdded:Connect(function() task.wait(1); if espOn then applyESP(p) end end)
end
