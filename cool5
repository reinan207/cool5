-- ===================== SALVAR TECLA =====================
local SAVE_FILE = "hubmenu_key.txt"
local SERVER_FILE = "saved_server.txt"
local MenuKey = Enum.KeyCode.Y

local function saveKey(key) pcall(function() writefile(SAVE_FILE, key.Name) end) end
local function loadKey()
    local ok, data = pcall(function() return readfile(SAVE_FILE) end)
    if ok and data and data ~= "" then
        local ok2, k = pcall(function() return Enum.KeyCode[data] end)
        if ok2 and k then MenuKey = k end
    end
end
loadKey()

local function saveServer(placeId, jobId)
    pcall(function() writefile(SERVER_FILE, placeId .. "|" .. jobId) end)
end
local function loadServer()
    local ok, data = pcall(function() return readfile(SERVER_FILE) end)
    if ok and data and data ~= "" then
        local placeId, jobId = data:match("^(.+)|(.+)$")
        if placeId and jobId then return placeId, jobId end
    end
    return nil, nil
end

