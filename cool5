    gui:Destroy()
    print("[HubUnificado] Script encerrado por completo.")
end)

-- ===================== TECLAS =====================
table.insert(inputConnections, UIS.InputBegan:Connect(function(inp, gpe)
    if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local k = inp.KeyCode
    if k == MenuKey and not searchFocused then
        frame.Visible = not frame.Visible
        PopupFrame.Visible = false
        return
    end
    if searchFocused then return end
    if gpe then return end
    if k == Enum.KeyCode.T then
        espOn=espToggle(); if espOn then enableESP() else disableESP() end
    elseif k == Enum.KeyCode.F then
        flyOn=flyToggle(); if flyOn then startFly() else stopFly() end
    elseif k == Enum.KeyCode.N then
        ncOn=ncToggle(); if ncOn then startNoclip() else stopNoclip() end
    elseif k == Enum.KeyCode.Z then
        toggleZoar()
    end
end))

