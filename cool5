-- ===================== ZOAR =====================
local setZoar, toggleZoar
do
    local ZOAR_MIN_DIST = 1    -- distância mínima na frente do alvo (studs)
    local ZOAR_TRAVEL   = 1    -- quanto você vai e volta (studs)
    local ZOAR_SPEED    = 36   -- velocidade do vai-e-vem

    local zoarOn, zoarTarget, zoarHB, zoarStep = false, nil, nil, nil
    local zoarCollide = {}
    local zoarLocked, zoarNext = nil, 0
    local BLOCK = { Enum.HumanoidStateType.Freefall, Enum.HumanoidStateType.Jumping, Enum.HumanoidStateType.FallingDown }

    local function myRoot() local c = lp.Character return c and c:FindFirstChild("HumanoidRootPart") end
    local function myHum() local c = lp.Character return c and c:FindFirstChildOfClass("Humanoid") end

    local function nearest()
        local r = myRoot()
        if not r then return end
        local best, bd
        for _, p in ipairs(Players:GetPlayers()) do
            local c = p ~= lp and p.Character
            local tr = c and c:FindFirstChild("HumanoidRootPart")
            local hm = c and c:FindFirstChildOfClass("Humanoid")
            if tr and hm and hm.Health > 0 then
                local d = (tr.Position - r.Position).Magnitude
                if not bd or d < bd then best, bd = p, d end
            end
        end
        return best
    end

    local function waistOffset(r)
        local c = lp.Character
        local part = c and (c:FindFirstChild("LowerTorso") or c:FindFirstChild("UpperTorso"))
        local att = part and part:FindFirstChild("WaistRigAttachment")
        if att and att:IsA("Attachment") then
            local d = att.WorldPosition.Y - r.Position.Y
            if d == d and math.abs(d) < 20 then return d end
        end
        return 0
    end
    local function headY(tr, tc)
        local head = tc and tc:FindFirstChild("Head")
        if head and head:IsA("BasePart") then return head.Position.Y end
        return tr.Position.Y + tr.Size.Y / 2
    end

    local function unlock()
        local h = zoarLocked
        zoarLocked = nil
        if h and h.Parent then
            for _, s in ipairs(BLOCK) do pcall(function() h:SetStateEnabled(s, true) end) end
        end
    end
    local function stand(h)
        if zoarLocked ~= h then
            unlock()
            zoarLocked, zoarNext = h, 0
            for _, s in ipairs(BLOCK) do pcall(function() h:SetStateEnabled(s, false) end) end
            pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
        end
        local now = os.clock()
        if now < zoarNext or h.Health <= 0 then return end
        zoarNext = now + 0.1
        if h:GetState() ~= Enum.HumanoidStateType.Running then
            pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
        end
        local an = h:FindFirstChildOfClass("Animator")
        if an then
            for _, t in ipairs(an:GetPlayingAnimationTracks()) do
                local n = t.Animation and t.Animation.Name
                if n == "FallAnim" or n == "JumpAnim" then pcall(function() t:Stop(0.1) end) end
            end
        end
    end

    setZoar = function(want)
        if want == zoarOn then return end
        if want then
            local p = nearest()
            if not p then return end            -- ninguém por perto: não liga
            zoarOn, zoarTarget = true, p
            zoarToggle()                        -- acende o botão
            zoarStep = RunService.Stepped:Connect(function()
                local c = lp.Character
                if not c then return end
                for _, part in ipairs(c:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then zoarCollide[part] = true; part.CanCollide = false end
                end
            end)
            zoarHB = RunService.Heartbeat:Connect(function()
                if not (zoarTarget and zoarTarget.Parent == Players) then return setZoar(false) end
                local tc = zoarTarget.Character
                local tr = tc and tc:FindFirstChild("HumanoidRootPart")
                local r, h = myRoot(), myHum()
                if not (tr and r and h) then return end
                r.AssemblyLinearVelocity, r.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
                h.Sit = false
                stand(h)
                local k = (math.sin(os.clock() * ZOAR_SPEED) + 1) / 2
                local flat = tr.CFrame.LookVector * (ZOAR_MIN_DIST + k * ZOAR_TRAVEL)
                local pos = Vector3.new(tr.Position.X + flat.X, headY(tr, tc) - waistOffset(r), tr.Position.Z + flat.Z)
                r.CFrame = CFrame.lookAt(pos, Vector3.new(tr.Position.X, pos.Y, tr.Position.Z))
            end)
        else
            zoarOn, zoarTarget = false, nil
            zoarToggle()                        -- apaga o botão
            if zoarHB then zoarHB:Disconnect(); zoarHB = nil end
            if zoarStep then zoarStep:Disconnect(); zoarStep = nil end
            for part in pairs(zoarCollide) do if part.Parent then part.CanCollide = true end end
            zoarCollide = {}
            unlock()
            local h = myHum()
            if h then h.Sit = false end
        end
    end

    toggleZoar = function() setZoar(not zoarOn) end
    zoarBtn.MouseButton1Click:Connect(toggleZoar)
    lp.CharacterAdded:Connect(function() setZoar(false) end)
    closeBtn.MouseButton1Click:Connect(function() setZoar(false) end)
end

-- ===================== LISTA DE JOGADORES =====================
local function createPlayerCard(player)
    if player == lp then return end
    local Card = Instance.new("TextButton")
    Card.Name = player.Name
    Card.Size = UDim2.new(1, 0, 0, 48)
    Card.BackgroundColor3 = CARD
    Card.BorderSizePixel = 0; Card.Text = ""; Card.AutoButtonColor = false
    Card.Parent = ScrollFrame
    Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 8)
    local cStr = Instance.new("UIStroke", Card)
    cStr.Color = ACCENT; cStr.Thickness = 1

    local Avatar = Instance.new("ImageLabel")
    Avatar.Size = UDim2.new(0, 36, 0, 36); Avatar.Position = UDim2.new(0, 6, 0.5, -18)
    Avatar.BackgroundColor3 = Color3.fromRGB(30, 30, 50); Avatar.BorderSizePixel = 0
    Avatar.Image = "https://www.roblox.com/headshot-thumbnail/image?userId="..player.UserId.."&width=150&height=150&format=png"
    Avatar.Parent = Card
    Instance.new("UICorner", Avatar).CornerRadius = UDim.new(1, 0)
    local aStr = Instance.new("UIStroke", Avatar)
    aStr.Color = ACCENT; aStr.Thickness = 1.5

    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(1, -52, 1, 0); NameLabel.Position = UDim2.new(0, 48, 0, 0)
    NameLabel.BackgroundTransparency = 1; NameLabel.TextColor3 = TEXTW
    NameLabel.Font = Enum.Font.GothamSemibold; NameLabel.TextSize = 11
    NameLabel.Text = player.DisplayName.."\n@"..player.Name
    NameLabel.TextXAlignment = Enum.TextXAlignment.Left; NameLabel.Parent = Card

    Card.MouseEnter:Connect(function()
        TS:Create(Card, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(30, 10, 50)}):Play()
        cStr.Color = ACCENT2
    end)
    Card.MouseLeave:Connect(function()
        TS:Create(Card, TweenInfo.new(0.12), {BackgroundColor3 = CARD}):Play()
        cStr.Color = ACCENT
    end)

    Card.MouseButton1Click:Connect(function()
        selectedPlayer = player
        PopupName.Text = "👤 " .. player.DisplayName
        local absPos = Card.AbsolutePosition
        local frameAbsPos = frame.AbsolutePosition
        local frameAbsSize = frame.AbsoluteSize
        PopupFrame.Position = UDim2.new(0, frameAbsPos.X + frameAbsSize.X + 8, 0, absPos.Y)
        PopupFrame.Visible = true
    end)
end

local function refreshList()
    for _, c in ipairs(ScrollFrame:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp then createPlayerCard(p) end
    end
end

